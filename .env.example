# Only /api/places uses API_DATA_MODE. Stations/routes/accidents/weather are always live.
API_DATA_MODE=live
# Seoul Open Data key (server only)
SEOUL_API_KEY=
# data.go.kr key with bicycle accident service approval (server only)
DATA_GO_KR_API_KEY=
# data.go.kr short-term forecast key, NOT apihub.kma.go.kr authKey (server only)
# Empty uses DATA_GO_KR_API_KEY as fallback.
KMA_SERVICE_KEY=
# Kakao REST API key (server only)
KAKAO_REST_API_KEY=
# Browser-public JavaScript SDK key; restrict its allowed domains in Kakao console.
NEXT_PUBLIC_KAKAO_MAP_KEY=
# Seoul official port 8088 uses HTTP; server-to-provider traffic is unencrypted.
SEOUL_ALLOW_HTTP=true
